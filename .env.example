# Postgres
POSTGRES_USER=contentsy
POSTGRES_PASSWORD=changeme
POSTGRES_DB=contentsy_db
# port host beda dari default 5432 — hindari bentrok kalau ada backend lain (mis. momokurasu) yang sudah pakai 5432
POSTGRES_PORT=5433

# Redis
# port host beda dari default 6379 — hindari bentrok
REDIS_PORT=6380

# API
API_PORT=8001

# Composed by docker-compose (jangan diisi manual, override otomatis via docker-compose.yml)
# DATABASE_URL=postgresql+psycopg://contentsy:changeme@db:5432/contentsy_db
# REDIS_URL=redis://redis:6379/0

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Auth (BE-Azriel-02)
# generate: openssl rand -hex 32  (min 32 karakter, app gagal start kalau kosong)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
SIGNUP_CREDITS=10
# origin frontend, pisah koma
CORS_ORIGINS=http://localhost:3000

# Upload (BE-Azriel-03)
MAX_UPLOAD_SIZE_MB=500
# UPLOAD_DIR di-set docker-compose ke /data/uploads (named volume, dishare api + worker)
